<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.poznamkovaruleta.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <top>
        <Label text="Poznámková ruleta" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="15.0" />
            </BorderPane.margin>
            <font>
                <Font name="System Bold" size="12.0" />
            </font></Label>
    </top>

    <left>
        <VBox prefWidth="220.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Žáci">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font></Label>
                <TextField fx:id="textZaci" promptText="Jméno žáka..." />
                <HBox spacing="10.0">
                    <children>
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onPridatZaka" text="Přidat" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onSmazatZaka" text="Smazat" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <ListView fx:id="listZaci" VBox.vgrow="ALWAYS" />
            </children>
            <BorderPane.margin>
                <Insets right="15.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <right>
        <VBox prefWidth="220.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Poznámky">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font></Label>
                <TextField fx:id="textPoznamky" promptText="Text poznámky..." />
                <HBox spacing="10.0">
                    <children>
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onPridatPoznamku" text="Přidat" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onSmazatPoznamku" text="Smazat" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <ListView fx:id="listPoznamky" VBox.vgrow="ALWAYS" />
            </children>
            <BorderPane.margin>
                <Insets left="15.0" />
            </BorderPane.margin>
        </VBox>
    </right>

    <center>
        <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                <Button mnemonicParsing="false" onAction="#onUdelitPoznamku" text="Udělit poznámku">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font></Button>

                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <VBox alignment="CENTER" prefWidth="240.0" spacing="2.0">
                            <Label text="Vybraný žák:" />
                            <Label fx:id="labelVybranyZak" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="2.0">
                            <Label text="Poznámka:" />
                            <Label fx:id="labelVybranaPoznamka" textAlignment="CENTER" wrapText="true" />
                     <Label text="Skrytá hláška:" />
                     <Label fx:id="labelSkrytaHlaska" />
                        </VBox>
                    </children>
                </VBox>
            <Button mnemonicParsing="false" onAction="#onZaka" text="Spin žák">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#onPoznamka" text="Spin poznámka">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            </children>
        </VBox>
    </center>
</BorderPane>
